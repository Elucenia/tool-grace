{
  "tool": {
    "id": "grace",
    "title": "Escore GRACE (mortalidade hospitalar)",
    "short": "Risco de morte na síndrome coronariana aguda",
    "desc": "Calcule o escore GRACE da síndrome coronariana aguda: pontos do nomograma de Granger, probabilidade de óbito hospitalar e risco para estratégia invasiva.",
    "lead": "Estima o risco de morte durante a internação em todo o espectro da síndrome coronariana aguda, com 8 variáveis da admissão; na SCA sem supra de ST, orienta o momento da estratégia invasiva.",
    "kind": "Calculadora",
    "spec": [
      "cardiologia",
      "medicina-de-emergencia",
      "medicina-intensiva"
    ],
